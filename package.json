{
  "name": "cnipac",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "CNIPAC — Carte Numerique Interactive des Producteurs d'Archives au Cameroun",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky || true",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration -w @cnipac/backend",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:a11y": "playwright test --config=tests/e2e/playwright.config.ts --grep @a11y",
    "build": "npm run build --workspaces --if-present",
    "gate:bundle": "node scripts/gate-bundle-budget.mjs",
    "gate:licences": "node scripts/gate-licences.mjs",
    "gate:migrations": "node scripts/gate-migrations.mjs",
    "gate:tracabilite": "node scripts/gate-tracabilite.mjs",
    "gate:coverage": "node scripts/gate-coverage.mjs",
    "gate:all": "npm run gate:licences && npm run gate:migrations && npm run gate:tracabilite",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "devDependencies": {
    "@cnipac/eslint-config": "*",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.6",
    "license-checker-rseidelsohn": "^4.4.2",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
