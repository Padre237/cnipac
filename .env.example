# =============================================================================
# CNIPAC — variables d'environnement de DEVELOPPEMENT LOCAL uniquement
# ADR-033 : en PREPROD et PROD, aucun secret ne passe par une variable
# d'environnement. Les secrets y sont montes en fichiers (suffixe _FILE).
# Ce fichier ne doit contenir QUE des valeurs factices.
# =============================================================================

NODE_ENV=development
CNIPAC_ENV=dev
PORT=3000
TZ=Africa/Douala                       # NFR-C8-03 : UTC+1

# --- Base de donnees (conteneur local) ---
DATABASE_URL=postgresql://cnipac:changeme-en-local@localhost:5432/cnipac_dev
# En PREPROD/PROD : DATABASE_URL_FILE=/run/secrets/db_url

# --- Redis (ADR-022 : AOF active, base 2 reservee a la revocation JWT) ---
REDIS_URL=redis://localhost:6379
REDIS_DB_CACHE=0
REDIS_DB_RATELIMIT=1
REDIS_DB_REVOCATION=2

# --- Authentification (M6) ---
JWT_SECRET=changeme-en-local-32-octets-minimum
JWT_ACCESS_TTL=15m                     # SDD §6.5.4
JWT_REFRESH_TTL=7d
# En PREPROD/PROD : JWT_SECRET_FILE=/run/secrets/jwt_secret

# --- Connecteur KoboToolbox (M1) ---
# ADR-034 : en DEV et PREPROD, projet Kobo de TEST uniquement.
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_ASSET_UID=EXEMPLE_ASSET_UID
KOBO_TOKEN=changeme-en-local
KOBO_SYNC_CRON=*/15 * * * *            # FR-M1-01 : soumission en quarantaine < 15 min

# --- Cartographie (M2) ---
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
CARTE_BBOX_CAMEROUN=8.4,1.6,16.2,13.1  # RG-M2-03 : enveloppe de validite

# --- API publique (M7) ---
API_VERSION=v1                         # ADR-037
API_PUBLIC_RATE_LIMIT=60               # requetes/minute (NFR-C3-08)

# --- Observabilite (ADR-038) ---
LOG_LEVEL=debug
METRICS_ENABLED=true

# --- Fonctionnalites (ADR-016 : feature flags pour les travaux > 72 h) ---
FEATURE_M5_CROWDSOURCING=false         # active en P2
FEATURE_M7_API_PUBLIQUE=false          # active en P2
FEATURE_MFA=false                      # active en P2 (FR-M6-04)
